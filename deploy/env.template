# VOXY environment template — contains NO real secrets.
# Copy to .env (local) or enter the values in your hosting platform's "Variables" UI.
# Never commit a filled-in copy.

# ---------- Required ----------
# Telegram bot token from @BotFather (used by the bot AND to verify Mini App initData)
BOT_TOKEN=
# Gemini API key from Google AI Studio (server-side only, never sent to the browser)
GEMINI_API_KEY=
# Public HTTPS URL of the Mini App (Telegram requires HTTPS), must end with /miniapp/
MINI_APP_URL=https://your-domain.example/miniapp/
# Public HTTPS URL of the backend (same host as the Mini App)
BACKEND_URL=https://your-domain.example

# ---------- Environment ----------
# development | production. In production the server refuses to start if anything above is
# missing, if URLs are not https://, or if DEV_SKIP_TELEGRAM_AUTH is true.
APP_ENV=production
# Local browser testing without Telegram (http://localhost only). MUST be false in production.
DEV_SKIP_TELEGRAM_AUTH=false

# ---------- Security ----------
# Comma-separated browser origins allowed to call the voice API. Leave empty to allow only the
# origins of MINI_APP_URL and BACKEND_URL (recommended; the Mini App is served same-origin).
ALLOWED_ORIGINS=

# ---------- Gemini ----------
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_SUMMARY_MODEL=gemini-3.8-flash
# Comma-separated, tried in order if the summary model returns 503/429 or is too slow
GEMINI_SUMMARY_FALLBACK_MODELS=gemini-3.6-flash

# ---------- Limits ----------
# Max voice session length in seconds (30-1800)
VOICE_MAX_SESSION_SECONDS=600
# Max age of Telegram initData in seconds (60-86400)
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600

# ---------- Server (uvicorn) ----------
# Trust X-Forwarded-* from the platform's TLS proxy. "*" is fine when the app is reachable ONLY
# through that proxy (managed platforms); on a VPS set the proxy's IP, e.g. 127.0.0.1.
FORWARDED_ALLOW_IPS=*

# ---------- Set by the platform (usually do not set yourself) ----------
# PORT=8000
