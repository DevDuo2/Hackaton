# ==========================================
# VOXY BACKEND ENV SOZLAMALARI (NAMUNA)
# ==========================================
# Bu fayl git'da saqlanadi — HECH QACHON haqiqiy kalit yozmang.
# Nusxa oling va to'ldiring:  cp .env.example .env

# 1. MongoDB Atlas ulanish havolasi:
MONGO_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
DB_NAME=voxy_db

# 2. JWT imzo kaliti — tasodifiy 32+ belgi. Generatsiya:
#    python -c "import secrets; print(secrets.token_urlsafe(48))"
#    APP_ENV=production bo'lsa va bu bo'sh/standart bo'lsa, server ishga tushmaydi.
JWT_SECRET=

# 3. Google Gemini AI kaliti (AI Tutor matnli chat uchun):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 4. Telegram Bot Token (ovozli bot alohida servis — ildizdagi deploy/env.template):
TELEGRAM_BOT_TOKEN=

# 4.1. /api/telegram/webhook uchun secret token. Bo'sh bo'lsa webhook 503 qaytaradi.
#      DIQQAT: haqiqiy bot long polling bilan ishlaydi — bu webhookni Telegramga
#      ro'yxatdan o'tkazsangiz, bot ishlamay qoladi.
TELEGRAM_WEBHOOK_SECRET=

# 5. Muhit va CORS:
APP_ENV=development
# Frontend manzillari, vergul bilan ajratilgan:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 6. Server porti (Render.com buni avtomatik beradi; lokalda sayt API 8001-portda):
PORT=8001
